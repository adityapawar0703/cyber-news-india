# Cyber India News - Frontend Environment Variables Template
#
# In local development:
# Leave empty to let Vite proxy /api and /uploads requests to http://localhost:5000
#
# In production (e.g. Vercel, Netlify, Cloudflare Pages):
# Set this to your deployed backend API URL (WITHOUT a trailing slash).
# Example:
# VITE_API_BASE_URL=https://api.cyberindianews.in
# or:
# VITE_API_BASE_URL=https://cyber-india-news-api.onrender.com
VITE_API_BASE_URL=
