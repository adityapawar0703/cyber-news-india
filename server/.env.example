# Server Port (Render, Railway, Heroku automatically set process.env.PORT)
PORT=5000

# Environment mode: development | production
NODE_ENV=production

# MongoDB Connection String:
# For local development:
# MONGO_URI=mongodb://127.0.0.1:27017/cyber_india_news
# For production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/cyber_india_news?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/cyber_india_news?retryWrites=true&w=majority

# JWT Authentication Secret
# Generate a secure 64-char random string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_64_char_secret_string
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated, without trailing slashes)
# In production, include your deployed frontend domain(s) and custom domains:
# CLIENT_URL=https://cyberindianews.in,https://www.cyberindianews.in,https://cyber-india-news.vercel.app
CLIENT_URL=https://your-frontend-domain.com

# Initial Admin Seed Credentials (used only by utils/seed.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=editor@cyberindianews.in
ADMIN_PASSWORD="ReplaceWithAStrongPassword#2026"
